{% raw %}
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.5 var(--font); }
  code, .mono { font-family: var(--mono); font-size: .92em; }
  a { color: var(--accent); }
  h1, h2, h3 { line-height: 1.25; margin: 0; }
  h2 { font-size: 1.15rem; font-weight: 650; }
  h3 { font-size: .95rem; font-weight: 650; }
  button, input, select { font: inherit; color: inherit; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  [hidden] { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .skip { position: absolute; left: -999px; top: 8px; background: var(--surface); padding: 6px 10px; border-radius: 6px; z-index: 20; }
  .skip:focus { left: 16px; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 16px; }
  .muted { color: var(--muted); }

  .top { background: var(--surface); border-bottom: 1px solid var(--border); }
  .top .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 18px; padding-bottom: 18px; }
  .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .logo { flex: none; width: 38px; height: 38px; border-radius: 9px; background: var(--accent); color: #fff; display: grid; place-items: center; font-weight: 700; letter-spacing: -.02em; }
  .brand h1 { font-size: 1.25rem; font-weight: 700; }
  .brand p { margin: 2px 0 0; color: var(--muted); font-size: .9rem; }
  .ghost { background: transparent; border: 1px solid var(--border-strong); border-radius: 8px; padding: 6px 12px; cursor: pointer; color: var(--text); white-space: nowrap; }
  .ghost:hover { background: var(--surface-2); }

  main { padding-top: 20px; padding-bottom: 48px; }
  section, .fold, .method { margin-top: 24px; }
  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 16px; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
  .section-head p { margin: 0; color: var(--muted); font-size: .9rem; }

  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 10px 24px; margin: 0; }
  .meta div { min-width: 0; }
  .meta dt { color: var(--muted); font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; }
  .meta dd { margin: 2px 0 0; overflow-wrap: anywhere; }
  .alert { margin-top: 16px; border: 1px solid var(--high); background: var(--high-soft); border-radius: var(--radius); padding: 12px 16px; }
  .alert pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: .8rem; max-height: 240px; overflow: auto; }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  .stat { display: block; text-align: left; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 14px 16px; cursor: pointer; text-decoration: none; color: var(--text); position: relative; }
  .stat:hover { border-color: var(--border-strong); }
  .stat .n { display: block; font-size: 1.75rem; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .stat .l { display: block; color: var(--muted); font-size: .85rem; margin-top: 4px; }
  .stat.sev-high .n { color: var(--high); }
  .stat.sev-medium .n { color: var(--medium); }
  .stat.sev-low .n { color: var(--low); }
  .stat[aria-pressed="true"] { border-color: currentColor; box-shadow: 0 0 0 2px var(--accent) inset; }
  .stat.quiet { background: var(--surface-2); box-shadow: none; }

  .types { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 4px; }
  .type-row { width: 100%; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr) 56px; align-items: center; gap: 12px; padding: 7px 10px; background: transparent; border: 1px solid transparent; border-radius: 8px; cursor: pointer; text-align: left; }
  .type-row:hover { background: var(--surface-2); }
  .type-row[aria-pressed="true"] { background: var(--accent-soft); border-color: var(--accent); }
  .type-row .name { font-weight: 600; min-width: 0; overflow-wrap: anywhere; }
  .type-row .name code { display: block; font-weight: 400; color: var(--faint); font-size: .78rem; }
  .type-row .track { height: 8px; background: var(--surface-2); border-radius: 99px; overflow: hidden; }
  .type-row .track span { display: block; height: 100%; background: var(--accent); border-radius: 99px; min-width: 3px; }
  .type-row .n { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }

  .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
  table { border-collapse: collapse; width: 100%; font-size: .88rem; }
  th, td { padding: 7px 10px; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; }
  thead th { background: var(--surface-2); font-weight: 600; color: var(--muted); position: sticky; top: 0; }
  tbody tr:last-child > * { border-bottom: 0; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .heat th.vert { vertical-align: bottom; height: 132px; padding: 6px 4px; }
  .heat th.vert span { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; font-size: .8rem; }
  .heat td.cell { position: relative; text-align: center; padding: 0; min-width: 34px; }
  .heat td.cell::before { content: ""; position: absolute; inset: 2px; border-radius: 4px; background: var(--heat); opacity: calc(var(--h, 0) * .85); }
  .heat td.cell button, .heat td.cell span { position: relative; display: block; width: 100%; padding: 7px 4px; border: 0; background: transparent; cursor: pointer; font-variant-numeric: tabular-nums; font-weight: 600; }
  .heat td.cell.hot button { color: #fff; }
  .heat th[scope="row"] { min-width: 9em; max-width: 280px; }
  .linkish { background: none; border: 0; padding: 0; color: var(--accent); cursor: pointer; text-align: left; text-decoration: underline; text-decoration-color: transparent; overflow-wrap: anywhere; font-weight: 500; }
  .linkish:hover { text-decoration-color: currentColor; }
  .sev-mini { display: inline-flex; gap: 6px; font-variant-numeric: tabular-nums; }
  .sev-mini .h { color: var(--high); } .sev-mini .m { color: var(--medium); } .sev-mini .l { color: var(--low); }

  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; padding: 10px 12px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); position: sticky; top: 0; z-index: 6; }
  .filters input[type="search"] { flex: 1 1 240px; min-width: 0; padding: 7px 10px; border: 1px solid var(--border-strong); border-radius: 8px; background: var(--bg); }
  .filters select { padding: 6px 8px; border: 1px solid var(--border-strong); border-radius: 8px; background: var(--bg); max-width: 100%; }
  .filters label.inline { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: .88rem; max-width: 100%; }
  .chips { display: inline-flex; gap: 4px; }
  .chip { border: 1px solid var(--border-strong); background: var(--bg); border-radius: 99px; padding: 4px 11px; cursor: pointer; font-size: .85rem; }
  .chip[aria-pressed="true"] { color: #fff; border-color: transparent; }
  .chip.high[aria-pressed="true"] { background: var(--high); }
  .chip.medium[aria-pressed="true"] { background: var(--medium); }
  .chip.low[aria-pressed="true"] { background: var(--low); }
  :root[data-theme="dark"] .chip[aria-pressed="true"] { color: #10131a; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .chip[aria-pressed="true"] { color: #10131a; } }
  .dropdown { position: relative; }
  .dropdown > summary { list-style: none; cursor: pointer; border: 1px solid var(--border-strong); border-radius: 8px; padding: 6px 10px; background: var(--bg); white-space: nowrap; font-size: .9rem; }
  .dropdown > summary::-webkit-details-marker { display: none; }
  .dropdown > summary::after { content: " \25BE"; color: var(--muted); }
  .dropdown .menu { position: absolute; z-index: 10; top: calc(100% + 6px); left: 0; min-width: 260px; max-height: 340px; overflow: auto; background: var(--surface); border: 1px solid var(--border-strong); border-radius: var(--radius); box-shadow: 0 8px 28px rgba(0, 0, 0, .18); padding: 6px; }
  .check { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: 6px; cursor: pointer; }
  .check:hover { background: var(--surface-2); }
  .check .n { margin-left: auto; color: var(--muted); font-variant-numeric: tabular-nums; }
  .count { color: var(--muted); margin: 12px 2px 8px; font-size: .9rem; }

  .list { display: grid; gap: 12px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--faint); border-radius: var(--radius); box-shadow: var(--shadow); padding: 14px 16px; min-width: 0; }
  .card.sev-high { border-left-color: var(--high); }
  .card.sev-medium { border-left-color: var(--medium); }
  .card.sev-low { border-left-color: var(--low); }
  .card.advisory { opacity: .92; }
  .card-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .badges { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .badge { display: inline-block; font-size: .75rem; font-weight: 650; border-radius: 6px; padding: 2px 8px; line-height: 1.5; white-space: nowrap; }
  .badge.sev { text-transform: uppercase; letter-spacing: .04em; }
  .badge.high { background: var(--high-soft); color: var(--high); }
  .badge.medium { background: var(--medium-soft); color: var(--medium); }
  .badge.low { background: var(--low-soft); color: var(--low); }
  .badge.type { background: var(--surface-2); color: var(--text); border: 1px solid var(--border); }
  .badge.ok { background: transparent; color: var(--ok); border: 1px solid currentColor; }
  .keyrow { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
  .key { font-weight: 600; overflow-wrap: anywhere; }
  .copy { border: 1px solid var(--border-strong); background: transparent; border-radius: 6px; padding: 1px 8px; font-size: .75rem; cursor: pointer; color: var(--muted); white-space: nowrap; }
  .copy:hover { color: var(--text); background: var(--surface-2); }
  .copy.flash { color: var(--ok); border-color: var(--ok); }
  .loc { display: inline-flex; gap: 8px; color: var(--muted); font-size: .82rem; flex-wrap: wrap; min-width: 0; }
  .loc .section { overflow-wrap: anywhere; }
  .loc .section::before { content: "\00a7 "; }
  .conf { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; font-size: .82rem; color: var(--muted); }
  .conf .bar { width: 72px; height: 6px; background: var(--surface-2); border-radius: 99px; overflow: hidden; border: 1px solid var(--border); }
  .conf .fill { display: block; height: 100%; background: var(--accent); }
  .conf.mid .fill { background: var(--medium); }
  .conf.lo .fill { background: var(--faint); }
  .conf .num { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--text); }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 12px; }
  .col { min-width: 0; }
  .lbl { color: var(--muted); font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 4px; }
  .txt, .diff { background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; white-space: pre-wrap; overflow-wrap: anywhere; min-height: 2.3em; }
  .txt.empty { color: var(--faint); font-style: italic; }
  .ph { color: var(--ph); background: var(--ph-bg); border-radius: 4px; font-family: var(--mono); font-size: .9em; padding: 0 2px; }
  .tag { color: var(--tag); font-family: var(--mono); font-size: .9em; }
  .evidence { margin: 12px 0 0; display: flex; gap: 10px; align-items: baseline; }
  .evidence .lbl { flex: none; margin: 0; }
  .ev { overflow-wrap: anywhere; }
  .suggestion { margin-top: 10px; }
  del, ins { text-decoration: none; border-radius: 3px; padding: 0 1px; }
  del { background: var(--del-bg); color: var(--del); text-decoration: line-through; text-decoration-thickness: 1px; }
  ins { background: var(--ins-bg); color: var(--ins); }
  del.ws, ins.ws { text-decoration: none; }
  .chg { border-bottom: 1px dotted var(--muted); }
  .card-foot { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 6px 16px; color: var(--faint); font-size: .8rem; }
  .card-foot details summary { cursor: pointer; }
  .card-foot ul, .card-foot dl { margin: 6px 0 0; padding-left: 18px; color: var(--muted); }
  .card-foot dl { display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; padding-left: 0; }
  .card-foot dt { font-family: var(--mono); }
  .card-foot dd { margin: 0; overflow-wrap: anywhere; }
  .more { display: block; margin: 14px auto 0; padding: 9px 18px; border-radius: 8px; border: 1px solid var(--border-strong); background: var(--surface); cursor: pointer; }
  .more:hover { background: var(--surface-2); }
  .notice { background: var(--surface); border: 1px dashed var(--border-strong); border-radius: var(--radius); padding: 14px 16px; color: var(--muted); }
  .notice.error { border-color: var(--high); color: var(--high); }

  .fold { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
  .fold > summary { cursor: pointer; padding: 14px 16px; display: flex; align-items: center; gap: 10px; list-style: none; }
  .fold > summary::-webkit-details-marker { display: none; }
  .fold > summary::before { content: "\25B8"; color: var(--muted); transition: transform .15s; }
  .fold[open] > summary::before { transform: rotate(90deg); }
  .fold > summary h2 { font-size: 1.05rem; }
  .pill { background: var(--surface-2); border: 1px solid var(--border); border-radius: 99px; padding: 0 9px; font-size: .82rem; font-variant-numeric: tabular-nums; color: var(--muted); }
  .fold-body { padding: 0 16px 16px; }
  .fold-body > p { margin: 0 0 10px; color: var(--muted); font-size: .9rem; }
  .fold .filters { position: static; box-shadow: none; margin-bottom: 10px; }
  .lint td.msg { overflow-wrap: anywhere; min-width: 240px; }
  .lint td.keycell { overflow-wrap: anywhere; min-width: 160px; }
  .copy.small { margin-left: 2px; }

  .method { color: var(--text); }
  .method .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin-top: 12px; }
  .method p, .method li { color: var(--muted); font-size: .9rem; }
  .method ul { padding-left: 18px; margin: 8px 0 0; }
  .method dl { margin: 8px 0 0; }
  .method dt { font-weight: 600; margin-top: 8px; }
  .method dt code { font-weight: 400; color: var(--faint); margin-left: 6px; }
  .method dd { margin: 2px 0 0; color: var(--muted); font-size: .88rem; }
  .rubric { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 8px; }
  .rubric li { display: flex; gap: 10px; align-items: baseline; }
  .rubric .badge { flex: none; min-width: 64px; text-align: center; }
  .foot { margin-top: 28px; color: var(--faint); font-size: .8rem; text-align: center; }

  @media (max-width: 720px) {
    body { font-size: 14.5px; }
    .top .wrap { padding-top: 14px; padding-bottom: 14px; }
    .brand h1 { font-size: 1.1rem; }
    .pair { grid-template-columns: 1fr; }
    .filters { position: static; }
    .filters input[type="search"] { flex-basis: 100%; }
    .type-row { grid-template-columns: minmax(0, 1fr) 56px 40px; gap: 8px; }
    .conf { margin-left: 0; }
    .evidence { flex-direction: column; gap: 2px; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media print {
    .filters, .copy, .more, #theme, .skip { display: none !important; }
    .card, .panel, .table-wrap, .fold { box-shadow: none; break-inside: avoid; }
    body { background: #fff; }
  }
{% endraw %}
</style>
</head>
<body>
<a class="skip" href="#findings">Skip to findings</a>
<header class="top">
  <div class="wrap">
    <div class="brand">
      <span class="logo" aria-hidden="true">lq</span>
      <div>
        <h1>Localization QA report</h1>
        <p><span lang="{{ target_locale|replace('_', '-') }}">{{ target_locale }}</span> checked against <span lang="{{ source_locale|replace('_', '-') }}">{{ source_locale }}</span> &middot; locqa {{ version }}</p>
      </div>
    </div>
    <button id="theme" class="ghost" type="button">Theme: auto</button>
  </div>
</header>

<main class="wrap">
  <section class="panel" aria-label="Run details">
    <dl class="meta">
      <div><dt>Source</dt><dd><code>{{ source_path or "(in memory)" }}</code> &middot; {{ source_locale }}{% if source_messages is not none %} &middot; {{ source_messages|num }} messages{% endif %}</dd></div>
      <div><dt>Target</dt><dd><code>{{ target_path or "(in memory)" }}</code> &middot; {{ target_locale }}{% if target_messages is not none %} &middot; {{ target_messages|num }} messages{% endif %}</dd></div>
      <div><dt>Context</dt><dd>{% if pivots %}pivots: {% for p in pivots %}<code title="{{ p.path or '' }}">{{ p.lang }}</code>{% if not loop.last %}, {% endif %}{% endfor %}{% else %}no pivot languages{% endif %} &middot; {% if glossary_path %}glossary <code>{{ glossary_path }}</code> ({{ glossary_entries|num }} entries){% else %}no glossary{% endif %}</dd></div>
      <div><dt>Threshold</dt><dd>{% if min_confidence is not none %}reported when confidence &ge; {{ min_confidence }}{% else %}not recorded{% endif %}</dd></div>
      <div><dt>Generated</dt><dd>{% if generated_at %}<time datetime="{{ generated_at }}">{{ generated_at }}</time>{% else %}unknown{% endif %}</dd></div>
    </dl>
  </section>

  {% if detector_errors %}
  <div class="alert" role="alert">
    <strong>{{ detector_errors|length }} detector{{ "s" if detector_errors|length != 1 else "" }} failed</strong>; the report below is incomplete for {{ "them" if detector_errors|length != 1 else "it" }}.
    {% for name, error in detector_errors %}
    <details><summary><code>{{ name }}</code></summary><pre>{{ error }}</pre></details>
    {% endfor %}
  </div>
  {% endif %}

  <section aria-labelledby="summary-h">
    <div class="section-head"><h2 id="summary-h">Summary</h2><p>Click a card or a type to filter the findings.</p></div>
    <div class="cards">
      <button type="button" class="stat" data-reset><span class="n">{{ total|num }}</span><span class="l">findings reported</span></button>
      {% for card in severity_cards %}
      <button type="button" class="stat sev-{{ card.value }}" data-sev="{{ card.value }}" aria-pressed="false" title="{{ card.rubric }}"><span class="n">{{ card.count|num }}</span><span class="l">{{ card.value }} severity</span></button>
      {% endfor %}
      <a class="stat quiet" href="#advisory" data-open="advisory"><span class="n">{{ advisory_total|num }}</span><span class="l">advisory (below threshold)</span></a>
      <a class="stat quiet" href="#lint" data-open="lint"><span class="n">{{ lint_total|num }}</span><span class="l">lint items</span></a>
    </div>
    <div class="panel" style="margin-top: 12px">
      <h3>By issue type</h3>
      {% if type_rows %}
      <ul class="types">
        {% for row in type_rows %}
        <li><button type="button" class="type-row" data-type="{{ row.value }}" aria-pressed="false" title="{{ row.short }} ({{ (row.share * 100)|round(1) }}% of findings)">
          <span class="name">{{ row.title }}<code>{{ row.value }}</code></span>
          <span class="track" aria-hidden="true"><span style="width: {{ (row.bar * 100)|round(1) }}%"></span></span>
          <span class="n">{{ row.count|num }}</span>
        </button></li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="muted">No findings above the confidence threshold.</p>
      {% endif %}
    </div>
  </section>

  {% if heatmap.rows %}
  <section aria-labelledby="sections-h">
    <div class="section-head"><h2 id="sections-h">Issues by screen section</h2><p>Sections come from <code>@@comment</code> markers in the source file. Click a section or a cell to filter.</p></div>
    <div class="table-wrap">
      <table class="heat">
        <thead><tr>
          <th scope="col">Section</th>
          <th scope="col" class="num">Total</th>
          <th scope="col" class="num">H&nbsp;/&nbsp;M&nbsp;/&nbsp;L</th>
          {% for t in heatmap.types %}<th scope="col" class="vert" title="{{ t }}"><span>{{ issue_titles[t] }}</span></th>{% endfor %}
        </tr></thead>
        <tbody>
          {% for row in heatmap.rows %}
          <tr{% if loop.index > heatmap.visible %} class="extra" hidden{% endif %}>
            <th scope="row"><button type="button" class="linkish" data-section="{{ row.section if row.section is not none else '' }}" data-nosection="{{ '1' if row.section is none else '0' }}">{{ row.label }}</button></th>
            <td class="num">{{ row.total|num }}</td>
            <td class="num"><span class="sev-mini"><span class="h">{{ row.severity.high }}</span>/<span class="m">{{ row.severity.medium }}</span>/<span class="l">{{ row.severity.low }}</span></span></td>
            {% for cell in row.cells %}
            <td class="cell{% if cell.heat > 0.55 %} hot{% endif %}" style="--h: {{ cell.heat }}">{% if cell.count %}<button type="button" data-section="{{ row.section if row.section is not none else '' }}" data-nosection="{{ '1' if row.section is none else '0' }}" data-type="{{ cell.type }}" aria-label="{{ cell.count }} {{ cell.type }} in {{ row.label }}">{{ cell.count }}</button>{% endif %}</td>
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if heatmap.rows|length > heatmap.visible %}<button id="heat-more" type="button" class="more">Show all {{ heatmap.rows|length }} sections</button>{% endif %}
  </section>
  {% endif %}

  <section id="findings" aria-labelledby="findings-h">
    <div class="section-head"><h2 id="findings-h">Findings</h2><p>Press <kbd>/</kbd> to search.</p></div>
    <div class="filters" role="search">
      <label class="sr-only" for="q">Search findings</label>
      <input id="q" type="search" placeholder="Search key, source, target, evidence&hellip;" autocomplete="off" spellcheck="false">
      <details class="dropdown" id="type-dd">
        <summary>Issue type: <span id="type-label">all</span></summary>
        <div class="menu" id="type-menu" role="group" aria-label="Issue types"></div>
      </details>
      <div class="chips" role="group" aria-label="Severity">
        <button type="button" class="chip high" data-sev="high" aria-pressed="false">High</button>
        <button type="button" class="chip medium" data-sev="medium" aria-pressed="false">Medium</button>
        <button type="button" class="chip low" data-sev="low" aria-pressed="false">Low</button>
      </div>
      <label class="inline">Section <select id="section"></select></label>
      <label class="inline">Sort <select id="sort">
        <option value="default">Severity, file order</option>
        <option value="confidence">Confidence, highest first</option>
        <option value="line">Line in target file</option>
        <option value="type">Issue type</option>
        <option value="key">Key A&ndash;Z</option>
      </select></label>
      <button id="reset" type="button" class="ghost">Reset</button>
    </div>
    <p id="count" class="count" aria-live="polite">{{ total|num }} findings</p>
    <div id="list" class="list">
      <noscript><p class="notice">JavaScript is off, so the findings list is not shown. The summary above is complete, and every finding is in report.json.</p></noscript>
    </div>
    <button id="more" type="button" class="more" hidden>Show more</button>
  </section>

  <details id="advisory" class="fold">
    <summary><h2>Advisory (below confidence threshold)</h2><span class="pill">{{ advisory_total|num }}</span></summary>
    <div class="fold-body">
      <p>Findings with confidence below {{ min_confidence if min_confidence is not none else "the threshold" }}. They are kept for reviewers but are not in report.json or SARIF. The filters above apply here too.</p>
      <p id="adv-count" class="count" aria-live="polite"></p>
      <div id="adv-list" class="list"></div>
      <button id="adv-more" type="button" class="more" hidden>Show more</button>
    </div>
  </details>

  <details id="lint" class="fold">
    <summary><h2>Lint (file-level problems)</h2><span class="pill">{{ lint_total|num }}</span></summary>
    <div class="fold-body">
      <p>Problems outside the issue taxonomy, such as duplicate or extra keys. They are reported separately and never counted as findings.</p>
      {% if lint_total %}
      <div class="filters">
        <label class="sr-only" for="lint-q">Search lint</label>
        <input id="lint-q" type="search" placeholder="Search key, rule, message&hellip;" autocomplete="off" spellcheck="false">
        <label class="inline">Rule <select id="lint-rule"></select></label>
      </div>
      <p id="lint-count" class="count" aria-live="polite"></p>
      <div class="table-wrap">
        <table class="lint">
          <thead><tr><th scope="col">Severity</th><th scope="col">Rule</th><th scope="col">Key</th><th scope="col" class="num">Line</th><th scope="col">Message</th></tr></thead>
          <tbody id="lint-body"></tbody>
        </table>
      </div>
      <button id="lint-more" type="button" class="more" hidden>Show more</button>
      {% else %}
      <p>No lint items.</p>
      {% endif %}
    </div>
  </details>

  <footer id="methodology" class="method panel">
    <h2>Methodology</h2>
    <div class="grid">
      <div>
        <h3>Severity</h3>
        <ul class="rubric">
          {% for item in rubric %}
          <li><span class="badge sev {{ item.value }}">{{ item.value }}</span><span>{{ item.text }}</span></li>
          {% endfor %}
        </ul>
        <h3 style="margin-top: 16px">Confidence</h3>
        <p>Each detector gives every finding a confidence between 0 and 1. A value of 0.9 or more is a near-certain rule hit, such as a placeholder that lost its braces. Values from 0.6 to 0.85 are likely problems that deserve a reviewer&rsquo;s look. Anything below the threshold{% if min_confidence is not none %} of {{ min_confidence }}{% endif %} goes to the Advisory list and stays out of report.json and SARIF.</p>
        <p>There is at most one finding per key and issue type. When several detectors flag the same problem, the most confident one is kept and the others are listed under &ldquo;also reported by&rdquo;.</p>
        <h3 style="margin-top: 16px">This file</h3>
        <p>The report works offline and makes no network requests. Text from the ARB files is shown as plain text, and a Content-Security-Policy blocks every script except the report&rsquo;s own.</p>
      </div>
      <div>
        <h3>Issue types</h3>
        <dl>
          {% for item in issue_docs %}
          <dt>{{ item.doc.title }}<code>{{ item.value }}</code></dt>
          <dd>{{ item.doc.help }}</dd>
          {% endfor %}
        </dl>
        {% if lint_docs %}
        <h3 style="margin-top: 16px">Lint rules in this run</h3>
        <dl>
          {% for rule in lint_docs %}
          <dt><code>{{ rule }}</code></dt>
          <dd>{{ lint_help.get(rule, "File-level check.") }}</dd>
          {% endfor %}
        </dl>
        {% endif %}
      </div>
    </div>
    {% if detectors %}
    <h3 style="margin-top: 20px">Detectors</h3>
    <div class="table-wrap" style="margin-top: 8px">
      <table>
        <thead><tr><th scope="col">Detector</th><th scope="col" class="num">Findings</th><th scope="col" class="num">Advisory</th><th scope="col" class="num">Lint</th><th scope="col" class="num">Time</th></tr></thead>
        <tbody>
          {% for d in detectors %}
          <tr><td><code>{{ d.name }}</code>{% if d.failed %} <span class="badge high">failed</span>{% endif %}</td><td class="num">{{ d.findings|num }}</td><td class="num">{{ d.advisory|num }}</td><td class="num">{{ d.lint|num }}</td><td class="num">{% if d.seconds is not none %}{{ "%.2f"|format(d.seconds) }} s{% else %}&ndash;{% endif %}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </footer>
  <p class="foot">Generated by locqa {{ version }}{% if generated_at %} on {{ generated_at }}{% endif %}.</p>
</main>
<script type="application/json" id="locqa-data">{{ payload|tojson_safe }}</script>
<script>{{ app_js|safe }}</script>
</body>
</html>

{#- locqa HTML report. Inline scripts are captured first so their SHA-256 can go into the CSP below. -#}
{% set theme_js %}{% raw %}(function(){try{var t=localStorage.getItem('locqa-theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);}}catch(e){}})();{% endraw %}{% endset %}
{% set app_js %}{% raw %}
(function () {
  'use strict';
  var doc = document;
  var root = doc.documentElement;
  var NONE = '\u0000';
  var SEV = { high: 0, medium: 1, low: 2 };
  var PAGE = 50;
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function $(id) { return doc.getElementById(id); }
  function el(tag, cls, text) {
    var node = doc.createElement(tag);
    if (cls) node.className = cls;
    if (text !== undefined && text !== null) node.textContent = String(text);
    return node;
  }
  function add(parent) {
    for (var i = 1; i < arguments.length; i++) {
      var child = arguments[i];
      if (child === null || child === undefined || child === false) continue;
      parent.appendChild(typeof child === 'string' ? doc.createTextNode(child) : child);
    }
    return parent;
  }
  function fmt(n) { return Number(n).toLocaleString('en-US'); }
  function plural(n, one, many) { return fmt(n) + ' ' + (n === 1 ? one : many); }
  function btn(cls, text, label) {
    var b = el('button', cls, text);
    b.type = 'button';
    if (label) b.setAttribute('aria-label', label);
    return b;
  }
  function fail(message) {
    var box = $('list') || doc.body;
    box.textContent = '';
    add(box, el('p', 'notice error', message));
  }

  /* ---- theme ---------------------------------------------------------- */
  var THEMES = ['auto', 'light', 'dark'];
  var theme = root.getAttribute('data-theme') || 'auto';
  function showTheme() {
    var b = $('theme');
    if (b) { b.textContent = 'Theme: ' + theme; b.setAttribute('aria-label', 'Colour theme: ' + theme + '. Click to change.'); }
  }
  showTheme();
  if ($('theme')) {
    $('theme').addEventListener('click', function () {
      theme = THEMES[(THEMES.indexOf(theme) + 1) % THEMES.length];
      if (theme === 'auto') root.removeAttribute('data-theme'); else root.setAttribute('data-theme', theme);
      try { localStorage.setItem('locqa-theme', theme); } catch (e) { /* storage unavailable */ }
      showTheme();
    });
  }

  /* ---- data ----------------------------------------------------------- */
  var DATA;
  try {
    DATA = JSON.parse($('locqa-data').textContent);
  } catch (e) {
    fail('The embedded report data could not be read: ' + e.message);
    return;
  }
  var META = DATA.meta || {};
  var TYPES = DATA.issue_types || {};
  var FINDINGS = DATA.findings || [];
  var ADVISORY = DATA.advisory || [];
  var LINT = DATA.lint || [];

  function prep(list) {
    for (var i = 0; i < list.length; i++) {
      var f = list[i];
      f._n = i;
      f._sec = f.section === null || f.section === undefined ? NONE : String(f.section);
      f._hay = [f.key, f.source, f.target, f.evidence, f.suggestion, f.section, f.issue_type, f.detector, f.rule, f.message]
        .filter(function (v) { return v !== null && v !== undefined; }).join('\n').toLowerCase();
    }
  }
  prep(FINDINGS); prep(ADVISORY); prep(LINT);

  function typeTitle(t) { return (TYPES[t] && TYPES[t].title) || t; }
  function langTag(locale) { return locale ? String(locale).replace(/_/g, '-') : ''; }

  /* ---- copy ----------------------------------------------------------- */
  function legacyCopy(text) {
    var area = el('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.position = 'fixed';
    area.style.opacity = '0';
    doc.body.appendChild(area);
    area.select();
    var ok = false;
    try { ok = doc.execCommand('copy'); } catch (e) { ok = false; }
    doc.body.removeChild(area);
    return ok;
  }
  function copyText(text, button) {
    if (!button.hasAttribute('data-label')) button.setAttribute('data-label', button.textContent);
    function done(ok) {
      button.textContent = ok ? 'Copied' : 'Copy failed';
      button.classList.add('flash');
      clearTimeout(button._t);
      button._t = setTimeout(function () {
        button.textContent = button.getAttribute('data-label');
        button.classList.remove('flash');
      }, 1200);
    }
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(legacyCopy(text)); });
    } else {
      done(legacyCopy(text));
    }
  }
  doc.addEventListener('click', function (event) {
    var target = event.target.closest ? event.target.closest('[data-copy]') : null;
    if (target) copyText(target.getAttribute('data-copy'), target);
  });

  /* ---- text and diff -------------------------------------------------- */
  var MARK_RE = /(\{[^{}]*\}|<\/?[A-Za-z][^<>]*>)/;
  function marked(node, text) {
    var parts = String(text).split(MARK_RE);
    for (var i = 0; i < parts.length; i++) {
      if (!parts[i]) continue;
      if (i % 2 === 1) add(node, el('span', parts[i].charAt(0) === '{' ? 'ph' : 'tag', parts[i]));
      else add(node, parts[i]);
    }
    return node;
  }

  var TOKEN_RE;
  try {
    TOKEN_RE = new RegExp('\\{[^{}\\s]*\\}|\\s+|[\\p{L}\\p{M}\\p{N}_]+|[\\s\\S]', 'gu');
  } catch (e) {
    TOKEN_RE = /\{[^{}\s]*\}|\s+|[A-Za-z0-9_À-ɏͰ-ԯ]+|[\s\S]/g;
  }
  function tokens(text) { return String(text).match(TOKEN_RE) || []; }
  function chars(text) { return Array.from ? Array.from(String(text)) : String(text).split(''); }

  function diffSeq(a, b) {
    var ops = [], n = a.length, m = b.length, s = 0, i, j;
    while (s < n && s < m && a[s] === b[s]) s++;
    var ea = n, eb = m;
    while (ea > s && eb > s && a[ea - 1] === b[eb - 1]) { ea--; eb--; }
    for (i = 0; i < s; i++) ops.push([0, a[i]]);
    var N = ea - s, M = eb - s;
    if (N > 0 && M > 0 && N * M <= 250000) {
      var W = M + 1, dp = new Uint16Array((N + 1) * W);
      for (i = N - 1; i >= 0; i--) {
        for (j = M - 1; j >= 0; j--) {
          dp[i * W + j] = a[s + i] === b[s + j] ? dp[(i + 1) * W + j + 1] + 1 : Math.max(dp[(i + 1) * W + j], dp[i * W + j + 1]);
        }
      }
      i = 0; j = 0;
      while (i < N && j < M) {
        if (a[s + i] === b[s + j]) { ops.push([0, a[s + i]]); i++; j++; }
        else if (dp[(i + 1) * W + j] >= dp[i * W + j + 1]) { ops.push([-1, a[s + i]]); i++; }
        else { ops.push([1, b[s + j]]); j++; }
      }
      for (; i < N; i++) ops.push([-1, a[s + i]]);
      for (; j < M; j++) ops.push([1, b[s + j]]);
    } else {
      for (i = s; i < ea; i++) ops.push([-1, a[i]]);
      for (j = s; j < eb; j++) ops.push([1, b[j]]);
    }
    for (i = ea; i < n; i++) ops.push([0, a[i]]);
    return ops;
  }

  function runs(ops) {
    var out = [];
    for (var i = 0; i < ops.length; i++) {
      var last = out[out.length - 1];
      if (last && last.op === ops[i][0]) { last.text += ops[i][1]; last.count++; }
      else out.push({ op: ops[i][0], text: ops[i][1], count: 1 });
    }
    return out;
  }

  function codepoint(ch) {
    var hex = ch.codePointAt ? ch.codePointAt(0).toString(16) : ch.charCodeAt(0).toString(16);
    return 'U+' + ('0000' + hex.toUpperCase()).slice(-Math.max(4, hex.length));
  }

  function charChange(before, after) {
    var span = el('span', 'chg');
    var removed = [], added = [];
    var parts = runs(diffSeq(chars(before), chars(after)));
    for (var i = 0; i < parts.length; i++) {
      var p = parts[i];
      if (p.op === 0) add(span, p.text);
      else if (p.op < 0) { add(span, el('del', '', p.text)); removed.push(p.text); }
      else { add(span, el('ins', '', p.text)); added.push(p.text); }
    }
    var cps = function (list) { return chars(list.join('')).map(function (c) { return c + ' ' + codepoint(c); }).join(', '); };
    span.title = '− ' + (cps(removed) || 'nothing') + '   + ' + (cps(added) || 'nothing');
    return span;
  }

  function isWord(text) { return /\S/.test(text) && text.length <= 40; }

  function renderDiff(before, after) {
    var box = el('div', 'diff');
    var parts = runs(diffSeq(tokens(before), tokens(after)));
    for (var i = 0; i < parts.length; i++) {
      var p = parts[i], q = parts[i + 1];
      if (p.op !== 0 && q && q.op === -p.op && p.count === 1 && q.count === 1 && isWord(p.text) && isWord(q.text)) {
        var del = p.op < 0 ? p : q, ins = p.op < 0 ? q : p;
        add(box, charChange(del.text, ins.text));
        i++;
      } else if (p.op === 0) {
        add(box, p.text);
      } else {
        var node = el(p.op < 0 ? 'del' : 'ins', /^\s+$/.test(p.text) ? 'ws' : '', p.text);
        node.title = p.op < 0 ? 'removed' : 'added';
        add(box, node);
      }
    }
    if (!parts.length) add(box, el('span', 'muted', '(empty)'));
    return box;
  }

  /* ---- cards ---------------------------------------------------------- */
  function confBar(value) {
    var v = Math.max(0, Math.min(1, Number(value) || 0));
    var wrap = el('div', 'conf ' + (v >= 0.9 ? 'hi' : v >= 0.6 ? 'mid' : 'lo'));
    wrap.setAttribute('role', 'meter');
    wrap.setAttribute('aria-valuemin', '0');
    wrap.setAttribute('aria-valuemax', '1');
    wrap.setAttribute('aria-valuenow', String(v));
    wrap.setAttribute('aria-label', 'Confidence');
    wrap.title = 'Confidence ' + v.toFixed(2);
    var bar = el('span', 'bar'), fill = el('span', 'fill');
    fill.style.width = Math.round(v * 100) + '%';
    bar.appendChild(fill);
    return add(wrap, bar, el('span', 'num', v.toFixed(2)));
  }

  function textCol(label, locale, text) {
    var col = el('div', 'col');
    add(col, el('div', 'lbl', label + (locale ? ' · ' + locale : '')));
    var body = el('div', 'txt');
    if (locale) body.lang = langTag(locale);
    if (text === null || text === undefined || text === '') { body.classList.add('empty'); body.textContent = '(empty or missing)'; }
    else marked(body, text);
    return add(col, body);
  }

  function renderFinding(f) {
    var card = el('article', 'card sev-' + f.severity);
    var head = el('div', 'card-head');
    var badges = el('div', 'badges');
    add(badges, el('span', 'badge sev ' + f.severity, f.severity));
    var type = el('span', 'badge type', typeTitle(f.issue_type));
    type.title = f.issue_type + (TYPES[f.issue_type] ? ': ' + TYPES[f.issue_type].short : '');
    add(badges, type);
    if (f.reviewed_by_human) add(badges, el('span', 'badge ok', 'reviewed'));
    var keyRow = el('div', 'keyrow');
    var copy = btn('copy', 'Copy key', 'Copy key ' + f.key);
    copy.setAttribute('data-copy', f.key);
    add(keyRow, el('code', 'key', f.key), copy);
    var loc = el('div', 'loc');
    if (f.section !== null && f.section !== undefined) add(loc, el('span', 'section', f.section));
    if (f.line) add(loc, el('span', 'line', 'line ' + f.line));
    add(head, badges, keyRow, loc, confBar(f.confidence));
    add(card, head);

    var pair = el('div', 'pair');
    add(pair, textCol('Source', META.source_locale, f.source), textCol('Target', META.target_locale, f.target));
    add(card, pair);

    var evidence = el('p', 'evidence');
    add(evidence, el('span', 'lbl', 'Evidence'), el('span', 'ev', f.evidence));
    add(card, evidence);

    if (f.suggestion !== null && f.suggestion !== undefined) {
      var sug = el('div', 'suggestion');
      var bar = el('div', 'lbl');
      var copySug = btn('copy', 'Copy suggestion', 'Copy suggested text');
      copySug.setAttribute('data-copy', f.suggestion);
      add(bar, 'Suggestion — diff against target', copySug);
      add(sug, bar, renderDiff(f.target || '', f.suggestion));
      add(card, sug);
    }

    var foot = el('div', 'card-foot');
    if (f.detector) add(foot, el('span', '', 'detector: ' + f.detector));
    if (f.also_reported_by && f.also_reported_by.length) {
      var also = el('details', 'also');
      add(also, el('summary', '', 'also reported by ' + plural(f.also_reported_by.length, 'detector', 'detectors')));
      var ul = el('ul');
      f.also_reported_by.forEach(function (o) {
        add(ul, el('li', '', (o.detector || '?') + ' (' + Number(o.confidence || 0).toFixed(2) + '): ' + (o.evidence || '')));
      });
      add(also, ul);
      add(foot, also);
    }
    var extraKeys = f.extra ? Object.keys(f.extra) : [];
    if (extraKeys.length) {
      var more = el('details', 'extra');
      add(more, el('summary', '', 'details'));
      var dl = el('dl');
      extraKeys.forEach(function (k) {
        var v = f.extra[k];
        add(dl, el('dt', '', k), el('dd', '', typeof v === 'string' ? v : JSON.stringify(v)));
      });
      add(more, dl);
      add(foot, more);
    }
    if (foot.childNodes.length) add(card, foot);
    return card;
  }

  function renderLint(item) {
    var tr = el('tr');
    var sev = el('td'); add(sev, el('span', 'badge sev ' + item.severity, item.severity));
    var rule = el('td'); add(rule, el('code', '', item.rule));
    var key = el('td', 'keycell');
    var copy = btn('copy small', 'Copy', 'Copy key ' + item.key);
    copy.setAttribute('data-copy', item.key);
    add(key, el('code', 'key', item.key), ' ', copy);
    add(tr, sev, rule, key, el('td', 'num', item.line === null || item.line === undefined ? '' : String(item.line)), el('td', 'msg', item.message));
    return tr;
  }

  /* ---- paging --------------------------------------------------------- */
  function Pager(listEl, moreBtn, render) {
    this.listEl = listEl;
    this.moreBtn = moreBtn;
    this.render = render;
    this.items = [];
    this.shown = 0;
    var self = this;
    moreBtn.addEventListener('click', function () { self.next(); });
  }
  Pager.prototype.set = function (items) {
    this.items = items;
    this.shown = 0;
    this.listEl.textContent = '';
    this.next();
  };
  Pager.prototype.next = function () {
    var end = Math.min(this.items.length, this.shown + PAGE);
    var frag = doc.createDocumentFragment();
    for (var i = this.shown; i < end; i++) frag.appendChild(this.render(this.items[i]));
    this.listEl.appendChild(frag);
    this.shown = end;
    var rest = this.items.length - end;
    this.moreBtn.hidden = rest <= 0;
    if (rest > 0) this.moreBtn.textContent = 'Show ' + fmt(Math.min(rest, PAGE)) + ' more (' + fmt(rest) + ' left)';
  };

  /* ---- filters -------------------------------------------------------- */
  var state = { types: {}, sevs: {}, section: null, terms: [], sort: 'default' };

  function anySet(o) { for (var k in o) { if (o[k]) return true; } return false; }
  function matches(f) {
    if (anySet(state.types) && !state.types[f.issue_type]) return false;
    if (anySet(state.sevs) && !state.sevs[f.severity]) return false;
    if (state.section !== null && f._sec !== state.section) return false;
    for (var i = 0; i < state.terms.length; i++) { if (f._hay.indexOf(state.terms[i]) < 0) return false; }
    return true;
  }
  function cmp(a, b) { return a < b ? -1 : a > b ? 1 : 0; }
  var SORTS = {
    'default': function (a, b) { return (SEV[a.severity] - SEV[b.severity]) || (a._n - b._n); },
    confidence: function (a, b) { return (b.confidence - a.confidence) || (SEV[a.severity] - SEV[b.severity]) || (a._n - b._n); },
    key: function (a, b) { return cmp(a.key, b.key) || (a._n - b._n); },
    type: function (a, b) { return cmp(a.issue_type, b.issue_type) || (SEV[a.severity] - SEV[b.severity]) || (a._n - b._n); },
    line: function (a, b) { return ((a.line || 1e9) - (b.line || 1e9)) || (a._n - b._n); }
  };
  function select(list) { return list.filter(matches).sort(SORTS[state.sort] || SORTS['default']); }

  var listEl = $('list'), countEl = $('count');
  var mainPager = new Pager(listEl, $('more'), renderFinding);
  var advDetails = $('advisory');
  var advPager = $('adv-list') ? new Pager($('adv-list'), $('adv-more'), function (f) {
    var card = renderFinding(f);
    card.classList.add('advisory');
    return card;
  }) : null;
  var advPending = null;

  /* type menu, severity chips, section select */
  var typeCounts = {};
  FINDINGS.forEach(function (f) { typeCounts[f.issue_type] = (typeCounts[f.issue_type] || 0) + 1; });
  var typeOrder = Object.keys(TYPES).filter(function (t) {
    return typeCounts[t] || ADVISORY.some(function (f) { return f.issue_type === t; });
  });
  FINDINGS.concat(ADVISORY).forEach(function (f) { if (typeOrder.indexOf(f.issue_type) < 0) typeOrder.push(f.issue_type); });
  typeOrder.sort(function (a, b) { return ((typeCounts[b] || 0) - (typeCounts[a] || 0)) || cmp(a, b); });

  var typeMenu = $('type-menu');
  var typeBoxes = {};
  typeOrder.forEach(function (t) {
    var label = el('label', 'check');
    var box = el('input');
    box.type = 'checkbox';
    box.value = t;
    box.addEventListener('change', function () { state.types[t] = box.checked; apply(); });
    typeBoxes[t] = box;
    add(label, box, el('span', '', typeTitle(t)), el('span', 'n', fmt(typeCounts[t] || 0)));
    add(typeMenu, label);
  });
  if (!typeOrder.length) add(typeMenu, el('p', 'muted', 'No issue types to filter.'));

  var sectionCounts = {}, sectionValues = [];
  FINDINGS.concat(ADVISORY).forEach(function (f, i) {
    if (!(f._sec in sectionCounts)) { sectionCounts[f._sec] = 0; sectionValues.push(f._sec); }
    if (i < FINDINGS.length) sectionCounts[f._sec]++;
  });
  sectionValues.sort(function (a, b) { return (sectionCounts[b] - sectionCounts[a]) || cmp(a, b); });
  var sectionSel = $('section');
  add(sectionSel, el('option', '', 'All sections'));
  sectionSel.options[0].value = '';
  sectionValues.forEach(function (s, i) {
    var option = el('option', '', (s === NONE ? '(no section)' : s) + ' — ' + fmt(sectionCounts[s]));
    option.value = String(i);
    add(sectionSel, option);
  });
  sectionSel.addEventListener('change', function () {
    state.section = sectionSel.value === '' ? null : sectionValues[Number(sectionSel.value)];
    apply();
  });
  function setSection(value) {
    var idx = value === null ? -1 : sectionValues.indexOf(value);
    state.section = idx < 0 ? null : value;
    sectionSel.value = idx < 0 ? '' : String(idx);
  }

  $('sort').addEventListener('change', function () { state.sort = $('sort').value; apply(); });

  var search = $('q'), searchTimer = null;
  search.addEventListener('input', function () {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(function () {
      state.terms = search.value.toLowerCase().split(/\s+/).filter(Boolean);
      apply();
    }, 120);
  });
  search.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && search.value) {
      search.value = '';
      state.terms = [];
      apply();
      event.stopPropagation();
    }
  });

  function toggleSev(sev) { state.sevs[sev] = !state.sevs[sev]; apply(); }
  function toggleType(t) {
    state.types[t] = !state.types[t];
    if (typeBoxes[t]) typeBoxes[t].checked = !!state.types[t];
    apply();
  }
  function reset() {
    state.types = {}; state.sevs = {}; state.terms = []; state.sort = 'default';
    search.value = '';
    $('sort').value = 'default';
    setSection(null);
    for (var t in typeBoxes) typeBoxes[t].checked = false;
    apply();
  }
  function showList() {
    var target = $('findings');
    if (target && target.getBoundingClientRect().top > window.innerHeight * 0.5) {
      target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    }
  }

  doc.addEventListener('click', function (event) {
    var t = event.target.closest ? event.target.closest('[data-sev],[data-type],[data-section],[data-reset],[data-open]') : null;
    if (!t) return;
    if (t.hasAttribute('data-open')) {
      var d = $(t.getAttribute('data-open'));
      if (d) d.open = true;
      return;
    }
    if (t.hasAttribute('data-reset')) { reset(); showList(); return; }
    var fromSummary = !t.closest('.filters');
    if (t.hasAttribute('data-section')) {
      setSection(t.getAttribute('data-nosection') === '1' ? NONE : t.getAttribute('data-section'));
      if (t.hasAttribute('data-type')) {
        state.types = {};
        for (var k in typeBoxes) typeBoxes[k].checked = false;
        state.types[t.getAttribute('data-type')] = true;
        if (typeBoxes[t.getAttribute('data-type')]) typeBoxes[t.getAttribute('data-type')].checked = true;
      }
      apply();
    } else if (t.hasAttribute('data-sev')) {
      toggleSev(t.getAttribute('data-sev'));
    } else if (t.hasAttribute('data-type')) {
      toggleType(t.getAttribute('data-type'));
    }
    if (fromSummary) showList();
  });

  $('reset').addEventListener('click', reset);

  var typeDropdown = $('type-dd');
  doc.addEventListener('click', function (event) {
    if (typeDropdown.open && !typeDropdown.contains(event.target)) typeDropdown.open = false;
  });
  doc.addEventListener('keydown', function (event) {
    var tag = (event.target.tagName || '').toLowerCase();
    var typing = tag === 'input' || tag === 'textarea' || tag === 'select' || event.target.isContentEditable;
    if (event.key === '/' && !typing && !event.ctrlKey && !event.metaKey && !event.altKey) {
      event.preventDefault();
      search.focus();
      search.select();
    } else if (event.key === 'Escape' && typeDropdown.open) {
      typeDropdown.open = false;
      typeDropdown.querySelector('summary').focus();
    }
  });

  function pressed(selector, test) {
    var nodes = doc.querySelectorAll(selector);
    for (var i = 0; i < nodes.length; i++) nodes[i].setAttribute('aria-pressed', test(nodes[i]) ? 'true' : 'false');
  }

  function apply() {
    var shown = select(FINDINGS);
    mainPager.set(shown);
    var filtered = shown.length !== FINDINGS.length;
    countEl.textContent = FINDINGS.length === 0
      ? 'No findings above the confidence threshold.'
      : (filtered ? plural(shown.length, 'finding matches', 'findings match') + ' the filters (of ' + fmt(FINDINGS.length) + ')' : plural(FINDINGS.length, 'finding', 'findings'));
    if (!shown.length && FINDINGS.length) {
      var again = btn('linkish', 'Reset filters');
      again.setAttribute('data-reset', '');
      add(listEl, add(el('div', 'notice'), 'No findings match these filters. ', again));
    }
    if (advPager) {
      var adv = select(ADVISORY);
      $('adv-count').textContent = ADVISORY.length
        ? (adv.length === ADVISORY.length ? plural(adv.length, 'advisory finding', 'advisory findings') : fmt(adv.length) + ' of ' + fmt(ADVISORY.length) + ' advisory findings match the filters above')
        : 'Nothing below the threshold.';
      if (advDetails.open) { advPager.set(adv); advPending = null; } else { advPending = adv; }
    }
    var picked = [];
    for (var t in state.types) { if (state.types[t]) picked.push(t); }
    $('type-label').textContent = picked.length === 0 ? 'all' : picked.length === 1 ? typeTitle(picked[0]) : picked.length + ' selected';
    pressed('[data-sev]', function (n) { return !!state.sevs[n.getAttribute('data-sev')]; });
    pressed('.types [data-type]', function (n) { return !!state.types[n.getAttribute('data-type')]; });
  }

  if (advDetails) {
    advDetails.addEventListener('toggle', function () {
      if (advDetails.open && advPending) { advPager.set(advPending); advPending = null; }
    });
  }

  /* ---- lint ----------------------------------------------------------- */
  var lintDetails = $('lint');
  if (lintDetails && $('lint-body')) {
    var lintPager = new Pager($('lint-body'), $('lint-more'), renderLint);
    var lintState = { rule: '', terms: [] };
    var ruleSel = $('lint-rule');
    var ruleCounts = {};
    LINT.forEach(function (l) { ruleCounts[l.rule] = (ruleCounts[l.rule] || 0) + 1; });
    add(ruleSel, el('option', '', 'All rules'));
    ruleSel.options[0].value = '';
    Object.keys(ruleCounts).sort().forEach(function (r) {
      var option = el('option', '', r + ' — ' + fmt(ruleCounts[r]));
      option.value = r;
      add(ruleSel, option);
    });
    var lintDirty = true;
    var applyLint = function () {
      var rows = LINT.filter(function (l) {
        if (lintState.rule && l.rule !== lintState.rule) return false;
        for (var i = 0; i < lintState.terms.length; i++) { if (l._hay.indexOf(lintState.terms[i]) < 0) return false; }
        return true;
      });
      $('lint-count').textContent = rows.length === LINT.length ? plural(LINT.length, 'lint item', 'lint items') : fmt(rows.length) + ' of ' + fmt(LINT.length) + ' lint items';
      if (lintDetails.open) { lintPager.set(rows); lintDirty = false; } else { lintDirty = true; }
    };
    ruleSel.addEventListener('change', function () { lintState.rule = ruleSel.value; applyLint(); });
    var lintTimer = null;
    $('lint-q').addEventListener('input', function () {
      clearTimeout(lintTimer);
      lintTimer = setTimeout(function () {
        lintState.terms = $('lint-q').value.toLowerCase().split(/\s+/).filter(Boolean);
        applyLint();
      }, 120);
    });
    lintDetails.addEventListener('toggle', function () { if (lintDetails.open && lintDirty) applyLint(); });
    applyLint();
  }

  /* ---- heatmap -------------------------------------------------------- */
  var heatMore = $('heat-more');
  if (heatMore) {
    heatMore.addEventListener('click', function () {
      var rows = doc.querySelectorAll('.heat tr.extra');
      for (var i = 0; i < rows.length; i++) rows[i].hidden = false;
      heatMore.hidden = true;
    });
  }

  function openFromHash() {
    var id = (location.hash || '').slice(1);
    if (id === 'advisory' || id === 'lint') { var d = $(id); if (d) d.open = true; }
  }
  window.addEventListener('hashchange', openFromHash);
  openFromHash();

  try { apply(); } catch (e) { fail('The findings list could not be rendered: ' + e.message); }
  root.classList.add('js');
})();
